# ============================================================
# WATE Feature Test: Functions and Closures Expressions
# ============================================================

# 1. Named Function Definition
fn add(a, b) {
    return a + b
}

# 2. Anonymous Function / Expression Closure
set multiply = fn(x, y) {
    return x * y
}

out(f"add(5, 3) = {add(5, 3)}")
out(f"multiply(4, 5) = {multiply(4, 5)}")

if (add(5, 3) is 8 and multiply(4, 5) is 20) {
    out("✓ Functions and Closures test PASSED!")
} else {
    out("✗ Functions test FAILED!")
}
