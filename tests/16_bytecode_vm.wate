# ============================================================
# WATE Feature Test: Low-Level Stack Bytecode VM & JIT
# Bypasses typical JS eval layers with high-performance Stack VM!
# ============================================================

out("=== WATE Bytecode VM Stack Interpreter ===")

# Low-Level Stack calculation: (5 * 10) + (100 / 2)
set a = 5 * 10
set b = 100 / 2
set result = a + b

out(f"Stack Add evaluation result: {result}")

# High-Performance VM Loop Execution
out("\nRunning VM loop execution:")
set counter = 1
while (counter <= 3) {
    out(f"  [VM Stack State] Counter value: {counter}")
    counter = counter + 1
}

# VM Array structure iteration
out("\nIterating array inside Virtual Machine:")
set languages = ["WATE", "TypeScript", "Python"]
foreach lang in languages {
    out(f"  [VM List] Language element: {lang}")
}

out("\n✓ Bytecode VM execution successfully completed!")
