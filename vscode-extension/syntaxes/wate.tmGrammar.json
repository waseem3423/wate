{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "WATE",
  "scopeName": "source.wate",
  "patterns": [
    { "include": "#comments" },
    { "include": "#keywords" },
    { "include": "#functions" },
    { "include": "#fstrings" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#booleans" },
    { "include": "#libraries" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "name": "comment.line.hash.wate",
      "match": "#.*$"
    },
    "keywords": {
      "name": "keyword.control.wate",
      "match": "\\b(set|const|fn|async|await|return|import|class|extends|implements|interface|method|get|static|super|if|else|match|guard|while|do|repeat|loop|foreach|for|in|try|catch|finally|throw|break|continue|true|false|null|nil|is|not|and|or|True|False)\\b"
    },
    "functions": {
      "name": "entity.name.function.wate",
      "match": "\\b(fn)\\s+(\\w+)",
      "captures": {
        "1": { "name": "keyword.control.wate" },
        "2": { "name": "entity.name.function.wate" }
      }
    },
    "fstrings": {
      "name": "string.quoted.double.wate",
      "begin": "[fF]\"",
      "end": "\"",
      "patterns": [
        { "name": "constant.character.escape.wate", "match": "\\\\." },
        {
          "name": "meta.interpolation.wate",
          "begin": "\\{",
          "end": "\\}",
          "beginCaptures": {
            "0": { "name": "punctuation.section.interpolation.begin.wate" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.section.interpolation.end.wate" }
          },
          "patterns": [
            { "include": "$self" }
          ]
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.wate",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        { "name": "constant.character.escape.wate", "match": "\\\\." }
      ]
    },
    "numbers": {
      "name": "constant.numeric.wate",
      "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
    },
    "booleans": {
      "name": "constant.language.wate",
      "match": "\\b(True|False|true|false|null|nil)\\b"
    },
    "libraries": {
      "name": "support.class.wate",
      "match": "\\b(file|sys|http|math|str|input|json|date|color|os|env|regex|crypto|wpath|list|num)\\b"
    },
    "operators": {
      "name": "keyword.operator.wate",
      "match": "(==|!=|<=|>=|<|>|\\+|-|\\*|\\/|=|\\!|\\&\\&|\\|\\|)"
    }
  }
}
